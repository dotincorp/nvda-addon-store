#: addon\configuration.py:35
msgid "Single Line Text Display"
msgstr "Однострочный Текстовый Дисплей"

#: addon\configuration.py:36
msgid "Graphic/Multi Line Text Display"
msgstr "Графический/Многострочный Текстовый Дисплей"

#. Translators: Choice option for not moving navigator after scroll
#: addon\configuration.py:52
msgid "Do nothing"
msgstr "Ничего не делать"

#. Translators: Choice option for moving to first visible cell
#: addon\configuration.py:54
