#: addon\configuration.py:35
msgid "Single Line Text Display"
msgstr "Tek Satırlı Metin Ekranı"

#: addon\configuration.py:36
msgid "Graphic/Multi Line Text Display"
msgstr "Grafik/Çok Satırlı Metin Görüntüleme"

#. Translators: Choice option for not moving navigator after scroll
#: addon\configuration.py:52
msgid "Do nothing"
msgstr "Hiçbir şey yapma"

#. Translators: Choice option for moving to first visible cell
#: addon\configuration.py:54
msgid "Move to first visible cell"
msgstr "Görünür olan ilk hücreye git"

#. Translators: Choice option for moving to center cell
#: addon\configuration.py:56
msgid "Move to center cell"
msgstr "Hücreyi ortaya taşı"

#. Translators: Choice option for the existing NVDA-driven braille rendering.
#: addon\configuration.py:82
msgid "NVDA review cursor (multi-line follows navigator)"
msgstr "NVDA inceleme imleci (çok satırlı, gezinti çubuğunu takip eder)"

#. Translators: Choice option for the TactileDisplayAPI library-driven braille rendering.
#: addon\configuration.py:84
msgid "TactileDisplayAPI library (follows focused control)"
msgstr "TactileDisplayAPI kütüphanesi (odaklanmış denetimleri takip eder)"

#. Translators: Line spacing option — maximum lines, 8-dot braille.
#: addon\configuration.py:105
msgid "Auto (maximum lines, 8-dot braille)"
msgstr "Otomatik (maksimum satır, 8 noktalı Braille)"

#. Translators: Line spacing option — force six-dot braille for more lines (library mode only).
#: addon\configuration.py:107
msgid "Max Line Count (six-dot braille, library mode only)"
msgstr "Maksimum Satır Sayısı (altı noktalı Braille , yalnızca kütüphane kipi)"

#. Translators: Line spacing option — wider gaps between braille lines.
#: addon\configuration.py:109
msgid "Double Line Spacing (8-dot braille)"
msgstr "Çift Satır Aralığı (8 noktalı Braille)"

#. Translators: Message of the dialog shown when installing the add-on,
#. asking whether NVDA should detect Dot Pad displays automatically.
#: addon\installTasks.py:196
msgid "NVDA does not detect Dot Pad displays automatically by default. Do you want to enable automatic detection of the Dot Pad?\n"
"You can change this later in NVDA's braille settings."
msgstr "NVDA, varsayılan olarak Dot Pad ekranlarını otomatik olarak algılamaz. Dot Pad’in otomatik algılanmasını etkinleştirmek istiyor musunuz?\n"
"Bunu daha sonra NVDA’nın braille ayarlarından değiştirebilirsiniz."

#. Translators: Title of the dialog shown when installing the add-on, asking
#. whether NVDA should detect Dot Pad displays automatically.
#: addon\installTasks.py:202
msgid "Dot Pad: automatic detection"
msgstr "Dot Pad: otomatik algılama"

#. Translators: Message of the dialog shown when installing the add-on,
#. asking whether NVDA should stop blinking the braille cursor.
#: addon\installTasks.py:211
msgid "Dot Pad cells refresh slowly, so a blinking braille cursor does not work well. Do you want to turn the blinking cursor off?\n"
"This applies to all braille displays. You can change this later in NVDA's braille settings."
msgstr "Dot Pad hücreleri yavaş yenilenir, bu nedenle yanıp sönen braille imleci pek işe yaramaz. Yanıp sönen imleci kapatmak ister misiniz?\n"
"Bu, tüm braille ekranlar için geçerlidir. Bu ayarı daha sonra NVDA’nın braille ayarlarından değiştirebilirsiniz."

#. Translators: Title of the dialog shown when installing the add-on, asking
#. whether NVDA should stop blinking the braille cursor.
#: addon\installTasks.py:218
msgid "Dot Pad: blinking cursor"
msgstr "Dot Pad: yanıp sönen imleç"

#: addon\brailleDisplayDrivers\dotPad\driver.py:1058
msgid "DotPad"
msgstr "DotPad"

#: addon\brailleDisplayDrivers\dotPad\driver.py:1139
#, python-format
msgid "Bluetooth: %s"
msgstr "Bluetooth: %s"

#. Translators: description of the refresh
#. command for the multiline/graphical display.
#. No default gesture — the user can assign one via NVDA's Input
#. Gestures dialog.
#: addon\brailleDisplayDrivers\dotPad\driver.py:2235
msgid "Refreshes the Dot Pad display"
msgstr "Dot Pad ekranını yeniler"

#. Translators: description of the scroll backwards
#. command for the multiline/graphical display
#: addon\brailleDisplayDrivers\dotPad\driver.py:2249
msgid "Scrolls the multiline display backwards"
msgstr "Çok satırlı ekranı geriye doğru kaydırır"

#. Translators: description of the scroll forward command
#. for the multiline/graphical display
#: addon\brailleDisplayDrivers\dotPad\driver.py:2264
msgid "Scrolls the multiline display forward"
msgstr "Çok satırlı ekranı ileri doğru kaydırır"

#. Translators: description of the toggle screen capture mode command
#. for the DotPad braille display
#: addon\brailleDisplayDrivers\dotPad\driver.py:2279
msgid "Toggles between normal braille output and screen capture mode"
msgstr "Normal braille çıktısı ile ekran yakalama modu arasında geçiş yapar"

#. Translators: Message announced when screen capture mode is enabled
#: addon\brailleDisplayDrivers\dotPad\driver.py:2289
msgid "Screen capture mode"
msgstr "Ekran yakalama modu"

#. Translators: Message announced when screen capture mode is disabled
#: addon\brailleDisplayDrivers\dotPad\driver.py:2292
msgid "Normal mode"
msgstr "Normal kip"

#. Translators: description of the force table mode command
#. for the DotPad braille display
#: addon\brailleDisplayDrivers\dotPad\driver.py:2298
msgid "Forces table mode by scanning parent objects for a table"
msgstr "Tablo kipini, üst nesneleri tarayarak bir tablo aramak suretiyle zorlar"

#. Translators: Message announced when table mode is activated
#: addon\brailleDisplayDrivers\dotPad\driver.py:2323
msgid "Table mode"
msgstr "Tablo kipi"

#. Translators: Message announced when no table is found in parent objects
#: addon\brailleDisplayDrivers\dotPad\driver.py:2326
msgid "No table found"
msgstr "Tablo bulunamadı."

#. Translators: description of the graphic display command
#. for the DotPad braille display
#: addon\brailleDisplayDrivers\dotPad\driver.py:2332
msgid "Displays the review object as tactile graphics via TactileDisplayAPI"
msgstr "İnceleme nesnesini TactileDisplayAPI aracılığıyla dokunsal grafik olarak görüntüler"

#. Translators: description of the braille display command
#. for the DotPad braille display — symmetric to the tactile-graphic
#. force chord; "show as braille" on the navigator object.
#: addon\brailleDisplayDrivers\dotPad\driver.py:2366
msgid "Displays the review object as braille via the active braille presentation"
msgstr "İnceleme nesnesini, etkin olan braille görüntüleme yöntemi aracılığıyla braille olarak görüntüler"

